{
  "expo": {
    "name": "DermaScan",
    "slug": "dermascan-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "dermascan",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#2F6B5A"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "병변 사진 촬영을 위해 카메라 접근이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "병변 사진 업로드를 위해 사진 보관함 접근이 필요합니다.",
        "NSLocationWhenInUseUsageDescription": "가까운 협력 병원 추천을 위해 위치 접근이 필요합니다."
      }
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.dermascan.app"
    },
    "plugins": [
      "expo-camera",
      "expo-image-picker",
      "expo-notifications",
      "expo-secure-store",
      "expo-location",
      "expo-dev-client",
      [
        "react-native-fast-tflite",
        {
          "enableAndroidGpuLibraries": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4ac60e87-8056-436e-a2e5-0614a3a75753"
      }
    }
  }
}
